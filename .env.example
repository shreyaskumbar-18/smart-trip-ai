SECRET_KEY=replace-with-a-random-secret-before-use
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=mysql
DB_NAME=smarttrip
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Email OTP uses SMTP. Replace placeholders before testing registration or password reset.
# For Gmail, use an app password, not your normal account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=replace_with_provider_app_password
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=SmartTrip AI <your_email@example.com>
# Do not use the console email backend in a shared environment because it writes
# message contents (including verification codes) to standard output.

# Production: set DEBUG=0, use a unique high-entropy SECRET_KEY and configure
# ALLOWED_HOSTS. HTTPS redirect, secure cookies and HSTS default on when DEBUG=0.

# Zero-cost AI option: install Ollama locally and run `ollama pull llama3.2:3b`.
# auto tries local Ollama first, then OpenAI only if an API key is configured.
# Set AI_PROVIDER=ollama to use only the local model, or AI_PROVIDER=local for no LLM calls.
AI_PROVIDER=auto
AI_ALLOW_PAID_FALLBACK=0
OLLAMA_BASE_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=llama3.2:3b

# Optional paid API fallback. Leave blank to avoid API charges.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
