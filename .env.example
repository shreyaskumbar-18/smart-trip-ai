# ==================================================
# SmartTrip AI - Environment Configuration
# Copy this file to .env  (same folder as manage.py)
# and fill in your own values.
# ==================================================

# Django secret key - any long random string
SECRET_KEY=change-me-to-a-long-random-string

# True while developing, False in production
DEBUG=True

# Comma separated hosts allowed to serve the app
ALLOWED_HOSTS=localhost,127.0.0.1

# --------------------------------------------------
# DATABASE (MySQL is the default engine)
# Set DB_ENGINE=sqlite ONLY if you want a quick demo
# without installing MySQL.
# --------------------------------------------------
DB_ENGINE=mysql
DB_NAME=smarttrip_db
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# --------------------------------------------------
# EXTERNAL APIS (ALL OPTIONAL - the app falls back to
# built-in demo data when a key is missing)
# --------------------------------------------------

# OpenWeatherMap - free key from https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Currency conversion (open.er-api.com is keyless; this
# base URL rarely needs changing)
CURRENCY_API_URL=https://open.er-api.com/v6/latest/INR
